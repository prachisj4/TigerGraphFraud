# Backend Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with real credentials.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# TigerGraph Savanna Database Secret and Data-Plane REST Host URL
TIGERGRAPH_SECRET=your_tigergraph_secret
TIGERGRAPH_HOST=https://your-workspace-id.i.tgcloud.io:443
